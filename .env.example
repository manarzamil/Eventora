# ---------------------------------------------------------------------------
# Eventora — environment variables
# Copy to `.env` and adjust. Never commit the real `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Drizzle / postgres.js.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eventora"

# Separate database used by the integration test suite (`npm test`).
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eventora_test"

# Secret used to sign session JWTs. MUST be at least 32 characters.
# Generate one with:  openssl rand -base64 48
AUTH_SECRET="replace-me-with-a-long-random-string-at-least-32-chars"

# Lifetime of an authenticated session, in seconds. Default: 7 days.
AUTH_SESSION_TTL_SECONDS="604800"

# Public base URL of the deployment (used for absolute links and metadata).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
